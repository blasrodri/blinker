# rustc writes its objects beside the harness when a fixture's captured cargo
# invocation names no --out-dir. They are regenerated by every run, and three of
# them were committed by accident, which left the working tree permanently dirty
# after any suite.
*.rcgu.o
*.rlib
*.dylib
rustc-ice-*.txt

# Agent Bench generates 49 cargo crates; they are build output and live in
# $TMPDIR, but keep the old in-tree location ignored in case anyone points
# --out back at it.
bench/tasks/
